    "concurrently": "^9.0.0",
    "cssn": "^4.1.0",
    "esbuild": "^0.23.1",
    "eslint": "^8.26.0",
    "nodemon": "^3.1.7",
    "pino-pretty": "^11.2.2",
    "timeago.js": "^4.0.2"
  }
