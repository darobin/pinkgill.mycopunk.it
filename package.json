    "better-sqlite3": "^11.3.0",
    "commander": "^13.1.0",
    "cookie-parser": "^1.4.7",
    "express": "^4.20.0",
    "greenlock": "^2.8.9",
    "greenlock-store-fs": "^3.2.2",
    "install": "^0.13.0",
    "iron-session": "^8.0.3",
    "keytar": "^7.9.0",
    "kysely": "^0.27.4",
    "lit": "^3.2.0",
    "mime": "^4.0.7",
    "mime-types": "^2.1.35",
